<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PelangganTabController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="16.0" right="16.0" top="14.0" />
         </padding>
         <children>
            <Label style="-fx-font-weight: bold;" text="Cari Tamu:" />
            <TextField fx:id="txtCariPelanggan" prefWidth="300.0" promptText="Cari NIK, nama, atau telepon..." />
         </children>
      </HBox>
   </top>
   <center>
      <TableView fx:id="tablePelanggan" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colPelangganNik" minWidth="150.0" prefWidth="180.0" text="NIK (KTP)" />
          <TableColumn fx:id="colPelangganNama" minWidth="200.0" prefWidth="280.0" text="Nama Tamu" />
            <TableColumn fx:id="colPelangganTelepon" minWidth="130.0" prefWidth="160.0" text="No. Telepon" />
            <TableColumn fx:id="colPelangganMember" minWidth="140.0" prefWidth="180.0" text="Status Keanggotaan" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <BorderPane.margin>
            <Insets left="16.0" right="16.0" />
         </BorderPane.margin>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="14.0" left="16.0" right="16.0" top="12.0" />
         </padding>
         <children>
            <Button fx:id="btnTambahPelanggan" onAction="#onTambahPelanggan" styleClass="button-success" text="+ Tambah Pelanggan" />
            <Button fx:id="btnUbahPelanggan" onAction="#onUbahPelanggan" styleClass="button" text="Ubah Pelanggan" />
            <Button fx:id="btnHapusPelanggan" onAction="#onHapusPelanggan" styleClass="button-danger" text="Hapus Pelanggan" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
