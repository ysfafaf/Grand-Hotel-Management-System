<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RiwayatTabController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="16.0" right="16.0" top="14.0" />
         </padding>
         <children>
            <Label style="-fx-font-weight: bold;" text="Cari Reservasi:" />
            <TextField fx:id="txtCariRiwayat" prefWidth="300.0" promptText="Cari ID RSV, nama tamu, atau kamar..." />
            <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <Button fx:id="btnRefresh" onAction="#onRefreshData" styleClass="button-secondary" text="↻ Muat Ulang Data" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>
   <center>
      <TableView fx:id="tableRiwayat" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colRiwayatId" minWidth="90.0" prefWidth="100.0" text="ID Reservasi" />
          <TableColumn fx:id="colRiwayatCheckin" minWidth="90.0" prefWidth="110.0" text="Check-in" />
            <TableColumn fx:id="colRiwayatTamu" minWidth="150.0" prefWidth="200.0" text="Nama Tamu" />
            <TableColumn fx:id="colRiwayatKamar" minWidth="110.0" prefWidth="140.0" text="Kamar" />
            <TableColumn fx:id="colRiwayatDurasi" minWidth="70.0" prefWidth="90.0" text="Durasi" />
            <TableColumn fx:id="colRiwayatTotal" minWidth="110.0" prefWidth="140.0" text="Total Bayar" />
            <TableColumn fx:id="colRiwayatMetode" minWidth="120.0" prefWidth="160.0" text="Metode Bayar" />
            <TableColumn fx:id="colRiwayatStatus" minWidth="80.0" prefWidth="100.0" text="Status" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <BorderPane.margin>
            <Insets left="16.0" right="16.0" />
         </BorderPane.margin>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="14.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="14.0" left="16.0" right="16.0" top="12.0" />
         </padding>
         <children>
            <Button fx:id="btnCheckOut" onAction="#onCheckOut" styleClass="button-success" text="✓ Proses Check-out Kamar" />
            <Label style="-fx-text-fill: #718096; -fx-font-size: 11px;" text="*Check-out akan mengubah status reservasi menjadi SELESAI dan mengembalikan status kamar menjadi TERSEDIA." />
         </children>
      </HBox>
   </bottom>
</BorderPane>
