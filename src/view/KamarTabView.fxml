<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.KamarTabController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="16.0" right="16.0" top="14.0" />
         </padding>
         <children>
            <Label style="-fx-font-weight: bold;" text="Cari Kamar:" />
            <TextField fx:id="txtCariKamar" prefWidth="250.0" promptText="Ketik ID atau tipe kamar..." />
            <Label style="-fx-font-weight: bold;" text="Filter Status:">
               <HBox.margin>
                  <Insets left="16.0" />
               </HBox.margin>
            </Label>
            <ComboBox fx:id="cmbFilterStatusKamar" prefWidth="140.0" />
         </children>
      </HBox>
   </top>
   <center>
      <TableView fx:id="tableKamar" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colKamarId" minWidth="90.0" prefWidth="110.0" text="ID Kamar" />
          <TableColumn fx:id="colKamarTipe" minWidth="100.0" prefWidth="130.0" text="Tipe Kamar" />
            <TableColumn fx:id="colKamarFasilitas" minWidth="250.0" prefWidth="380.0" text="Fasilitas Kamar" />
            <TableColumn fx:id="colKamarTarif" minWidth="120.0" prefWidth="150.0" text="Tarif Dasar / Malam" />
            <TableColumn fx:id="colKamarStatus" minWidth="100.0" prefWidth="120.0" text="Status" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <BorderPane.margin>
            <Insets left="16.0" right="16.0" />
         </BorderPane.margin>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="14.0" left="16.0" right="16.0" top="12.0" />
         </padding>
         <children>
            <Button fx:id="btnTambahKamar" onAction="#onTambahKamar" styleClass="button-success" text="+ Tambah Kamar" />
            <Button fx:id="btnUbahKamar" onAction="#onUbahKamar" styleClass="button" text="Ubah Kamar" />
            <Button fx:id="btnHapusKamar" onAction="#onHapusKamar" styleClass="button-danger" text="Hapus Kamar" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
